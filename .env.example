# Sales Dashboard Environment Configuration
# Copy this file to .env and update the values as needed

# Application Configuration
VITE_APP_TITLE=Sales Dashboard
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Modern sales analytics dashboard

# API Configuration (Future Implementation)
VITE_API_BASE_URL=https://api.salesdashboard.com/v1
VITE_API_TIMEOUT=10000
VITE_API_RETRY_ATTEMPTS=3

# Authentication (Future Implementation)
VITE_AUTH_ENABLED=false
VITE_AUTH_PROVIDER=jwt
VITE_AUTH_REDIRECT_URL=/dashboard

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_REAL_TIME=false
VITE_ENABLE_EXPORT=false
VITE_ENABLE_NOTIFICATIONS=false

# Analytics & Monitoring (Future Implementation)
VITE_ANALYTICS_ENABLED=false
VITE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_HOTJAR_ID=

# Performance Configuration
VITE_CHART_ANIMATION_DURATION=300
VITE_DATA_REFRESH_INTERVAL=30000
VITE_CACHE_TTL=300000

# UI Configuration
VITE_DEFAULT_TIME_PERIOD=daily
VITE_DEFAULT_CURRENCY=USD
VITE_DEFAULT_LOCALE=en-US
VITE_THEME=dark

# Development Configuration
VITE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false
VITE_ENABLE_DEVTOOLS=true

# Build Configuration
VITE_BUILD_TIMESTAMP=
VITE_BUILD_VERSION=
VITE_BUILD_ENVIRONMENT=development
